# Copy to .env.local for local development. Never commit real secrets.

# Public base URL of this deployment (used for the Discord redirect).
FJD_APP_URL=http://localhost:3000

# Discord application (https://discord.com/developers/applications > OAuth2).
# Redirect URL to register there: <FJD_APP_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord webhooks (Components V2 messages). One URL per channel and per environment: in Vercel the
# production and preview values differ, so staging never posts into the production channel.
# Leave empty to switch the channel off, e.g. locally.
FJD_WEBHOOK_AMTSBLATT=

# Discord bot for the role sync: the bot only has to be a member of the server (no permissions needed).
# Roles of the dashboard follow the Discord roles of this guild; the Sicherheitsrat maps them under
# /intern/rollen. One bot token and guild per environment. Leave empty to keep manual roles only.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Roles are granted in the database, never through environment variables:
# locally with "bun run role:grant <discord-id> <role>", on staging and production in Supabase.

# Staging and production: Supabase Postgres through the transaction pooler (port 6543).
# Each environment has its own login role that can only reach its own schema.
# FJD_DB=postgres
# FJD_DATABASE_URL=postgresql://<role>.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Local development only: database driver and a test login without Discord.
FJD_DB=sqlite
FJD_DEV_LOGIN=1
