# Copy to .env.local for local development. Never commit real secrets.

# Public base URL of this deployment (used for the Discord redirect).
FJD_APP_URL=http://localhost:3000

# Discord application (https://discord.com/developers/applications > OAuth2).
# Redirect URL to register there: <FJD_APP_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord user IDs (comma separated) that receive a role when they sign in.
FJD_BOOTSTRAP_JM=
FJD_BOOTSTRAP_FR=

# Staging and production: Supabase Postgres through the transaction pooler (port 6543).
# Each environment has its own login role that can only reach its own schema.
# FJD_DB=postgres
# FJD_DATABASE_URL=postgresql://<role>.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Local development only: database driver and a test login without Discord.
FJD_DB=sqlite
FJD_DEV_LOGIN=1
