# Copy to .env.local for local development. Never commit real secrets.

# Public base URL of this deployment (used for the Discord redirect).
FJD_APP_URL=http://localhost:3000

# Discord application (https://discord.com/developers/applications > OAuth2).
# Redirect URL to register there: <FJD_APP_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord user IDs (comma separated) that become Justizminister on their first sign-in.
FJD_BOOTSTRAP_JM=

# Local development only: database driver and a test login without Discord.
FJD_DB=sqlite
FJD_DEV_LOGIN=1
